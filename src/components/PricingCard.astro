---
type Props = {
  name: string;
  description?: string;
  labor?: string;
  parts?: string;
  total?: string;
  note?: string;
};

const { name, description, labor, parts, total, note } = Astro.props as Props;
---

<div class="rounded-xl border bg-white p-6 shadow-sm">
  <!-- Title + Total -->
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-semibold leading-snug">{name}</h3>

    {total && (
      <div class="text-right">
        <div class="text-xs text-gray-500">Est. Total</div>
        <div class="text-base font-semibold text-gray-900">{total}</div>
      </div>
    )}
  </div>

  <!-- Description -->
  {description && (
    <p class="mt-2 text-sm leading-relaxed text-gray-700">
      {description}
    </p>
  )}

  <!-- Labor + Parts Breakdown -->
  {(labor || parts) && (
    <div class="mt-4 space-y-2 border-t pt-4 text-sm">
      {labor && (
        <div class="flex items-center justify-between">
          <span class="text-gray-600">Labor</span>
          <span class="font-medium text-gray-900">{labor}</span>
        </div>
      )}

      {parts && (
        <div class="flex items-center justify-between">
          <span class="text-gray-600">Parts</span>
          <span class="font-medium text-gray-900">{parts}</span>
        </div>
      )}
    </div>
  )}

  <!-- Optional Note -->
  {note && (
    <p class="mt-4 text-xs text-gray-500">
      {note}
    </p>
  )}
</div>
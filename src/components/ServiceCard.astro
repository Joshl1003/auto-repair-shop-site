---
type Props = {
  name: string;
  description: string;
  startingAt?: string;
};

const { name, description, startingAt } = Astro.props as Props;
---

<div class="group rounded-xl border bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-bold leading-snug text-slate-900">{name}</h3>
    {startingAt && (
      <span class="shrink-0 rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">
        {startingAt}+
      </span>
    )}
  </div>

  <p class="mt-2 text-sm leading-relaxed text-slate-600">
    {description}
  </p>

  {startingAt && (
    <p class="mt-4 text-xs text-slate-400">Starting at {startingAt} &middot; varies by vehicle</p>
  )}
</div>

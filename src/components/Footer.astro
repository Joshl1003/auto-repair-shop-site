---
import settings from "../content/site/settings.json";
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-black text-white">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      
      <!-- Contact -->
      <div>
        <div class="text-lg font-semibold">{settings.name}</div>

        <div class="mt-4 text-sm text-gray-300">
          <a class="hover:text-white" href={`tel:${settings.phoneHref}`}>
            {settings.phoneDisplay}
          </a>
        </div>

        <div class="mt-2 text-sm text-gray-300">
          <a
            class="hover:text-white"
            href={settings.googleMapsUrl}
            target="_blank"
            rel="noreferrer"
          >
            {settings.addressLine1}, {settings.cityStateZip}
          </a>
        </div>
      </div>

      <!-- Hours -->
      <div>
        <div class="text-lg font-semibold">Hours</div>

        <ul class="mt-4 space-y-2 text-sm text-gray-300">
          {settings.hours.map((h) => (
            <li class="flex justify-between">
              <span>{h.day}</span>
              <span>
                {h.open}{h.close ? ` – ${h.close}` : ""}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-4 text-xs text-gray-400">
          First come, first served — call for current wait times.
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <div class="text-lg font-semibold">Quick Links</div>

        <ul class="mt-4 space-y-2 text-sm text-gray-300">
          <li><a class="hover:text-white" href="/services">Services</a></li>
          <li><a class="hover:text-white" href="/pricing">Pricing</a></li>
          <li><a class="hover:text-white" href="/about">About</a></li>
          <li><a class="hover:text-white" href="/contact">Contact</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom copyright strip -->
  <div class="border-t border-gray-800">
    <div class="mx-auto max-w-6xl px-4 py-6 text-xs text-gray-400">
      © {year} {settings.name}. All rights reserved.
    </div>
  </div>
</footer>
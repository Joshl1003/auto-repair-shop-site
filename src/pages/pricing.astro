---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingCard from "../components/PricingCard.astro";
import prices from "../content/pricing/prices.json";

// Group [prices] by category
type Price = {
  name: string;
  description?: string;
  labor?: string;
  parts?: string;
  total?: string;
  note?: string;
  category: string;
};

const typedPrices = prices as Price[];

const pricesByCategory = typedPrices.reduce<Record<string, Price[]>>((acc, p) => {
  (acc[p.category] ??= []).push(p);
  return acc;
}, {});

const categoryOrder = [
  "Oil Changes",
  "Brake System",
  "Tires & Wheels",
  "Diagnostics",
  "Engine & Drivetrain",
  "Suspension & Steering",
];

const categories = Object.keys(pricesByCategory).sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  // Unknown categories go last (sorted alphabetically)
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});
---

<BaseLayout title="Pricing | AutoTech Repair">
  <div class="border-b pb-8">
    <span class="category-pill">Transparent Pricing</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">Pricing</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-600">
      Estimates are provided before work begins. Prices vary by vehicle make, model, and condition.
    </p>
  </div>

  <div class="mt-10 space-y-12">
    {categories.map((cat) => (
      <section>
        <div class="flex items-center gap-3">
          <h2 class="text-xl font-bold text-slate-900 md:text-2xl">{cat}</h2>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {pricesByCategory[cat].map((p) => (
            <PricingCard
              name={p.name}
              description={p.description}
              labor={p.labor}
              parts={p.parts}
              total={p.total}
              note={p.note}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../content/site/settings.json";
---

<BaseLayout title="Contact | AutoTech Repair">

  <!-- Page header -->
  <div class="border-b pb-8">
    <span class="category-pill">Get In Touch</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">
      Contact Us
    </h1>
    <p class="mt-3 max-w-2xl text-base text-slate-600">
      Give us a call or stop by — we're here Mon–Fri to help get your vehicle back in shape.
    </p>
  </div>

  <!-- Contact Cards -->
  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

    <!-- Phone -->
    <div class="rounded-2xl border bg-white p-7 shadow-sm">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-red-50 text-red-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
      </div>
      <h2 class="mt-4 text-lg font-bold text-slate-900">Phone</h2>
      <p class="mt-1 text-sm text-slate-500">Call for estimates and wait times</p>
      <a
        class="mt-4 inline-flex items-center gap-1 text-base font-semibold text-red-600 hover:underline"
        href={`tel:${settings.phoneHref}`}
      >
        {settings.phoneDisplay}
      </a>
    </div>

    <!-- Email -->
    <div class="rounded-2xl border bg-white p-7 shadow-sm">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-red-50 text-red-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </div>
      <h2 class="mt-4 text-lg font-bold text-slate-900">Email</h2>
      <p class="mt-1 text-sm text-slate-500">We'll get back to you as soon as possible</p>
      <a
        class="mt-4 inline-flex items-center gap-1 break-all text-base font-semibold text-red-600 hover:underline"
        href={`mailto:${settings.email}`}
      >
        {settings.email}
      </a>
    </div>

    <!-- Address -->
    <div class="rounded-2xl border bg-white p-7 shadow-sm">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-red-50 text-red-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
      </div>
      <h2 class="mt-4 text-lg font-bold text-slate-900">Location</h2>
      <p class="mt-1 text-sm text-slate-500">Stop by during business hours</p>
      <a
        class="mt-4 inline-flex flex-col text-base font-semibold text-red-600 hover:underline"
        href={settings.googleMapsUrl}
        target="_blank"
        rel="noreferrer"
      >
        <span>{settings.addressLine1}</span>
        <span>{settings.cityStateZip}</span>
      </a>
    </div>

  </div>

  <!-- Hours + Tow note -->
  <div class="mt-8 grid gap-5 md:grid-cols-2">

    <div class="rounded-2xl border bg-white p-7 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900">Business Hours</h2>
      <ul class="mt-4 space-y-3">
        {settings.hours.map((h) => (
          <li class="flex items-center justify-between border-b border-slate-100 pb-3 last:border-0 last:pb-0">
            <span class="text-sm font-medium text-slate-700">{h.day}</span>
            <span class={`text-sm font-semibold ${h.open === "Closed" ? "text-slate-400" : "text-slate-900"}`}>
              {h.open}{h.close ? ` – ${h.close}` : ""}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-slate-500">
        First come, first served. Call ahead to check current wait times.
      </p>
    </div>

    <div class="rounded-2xl bg-slate-900 p-7 text-white shadow-sm">
      <h2 class="text-lg font-bold">Need a tow?</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">
        If your vehicle doesn't run or is unsafe to drive, call us and we can arrange a third-party towing company. Just have ready:
      </p>
      <ul class="mt-4 space-y-2 text-sm text-slate-300">
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>Your name &amp; phone number
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>Vehicle make, model &amp; year
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>Current location of the vehicle
        </li>
      </ul>
      <a
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-700"
        href={`tel:${settings.phoneHref}`}
      >
        Call {settings.phoneDisplay}
      </a>
    </div>

  </div>

</BaseLayout>

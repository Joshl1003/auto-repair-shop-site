---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import services from "../content/services/services.json";

// Group services by category
type Service = {
  name: string;
  description: string;
  startingAt?: string;
  category: string;
};

const typedServices = services as Service[];

const servicesByCategory = typedServices.reduce<Record<string, Service[]>>((acc, s) => {
  (acc[s.category] ??= []).push(s);
  return acc;
}, {});

const categoryOrder = [
  "Oil Changes",
  "Brake System",
  "Tires & Wheels",
  "Diagnostics",
  "Engine & Drivetrain",
  "Suspension & Steering",
];

const categories = Object.keys(servicesByCategory).sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  // Unknown categories go last (sorted alphabetically)
  if (ai === -1 && bi === -1) return a.localeCompare(b);
  if (ai === -1) return 1;
  if (bi === -1) return -1;
  return ai - bi;
});
---

<BaseLayout title="Services | AutoTech Repair">
  <div class="border-b pb-8">
    <span class="category-pill">What We Do</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">Services</h1>
    <p class="mt-3 max-w-2xl text-base text-slate-600">
      First come, first served. Call for current wait times and availability.
    </p>
  </div>

  <div class="mt-10 space-y-12">
    {categories.map((cat) => (
      <section>
        <div class="flex items-center gap-3">
          <h2 class="text-xl font-bold text-slate-900 md:text-2xl">{cat}</h2>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {servicesByCategory[cat].map((s) => (
            <ServiceCard
              name={s.name}
              description={s.description}
              startingAt={s.startingAt}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

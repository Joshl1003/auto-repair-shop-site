---
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../content/site/settings.json";
import "../styles/global.css";
---

<BaseLayout title={`${settings.name} | Auto Repair`}>

  <!-- Hero -->
  <section class="rounded-2xl bg-slate-900 px-8 py-16 text-white md:px-14 md:py-24">
    <span class="inline-block rounded-full bg-red-600/20 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-red-400">
      Newport News, VA
    </span>
    <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight md:text-5xl lg:text-6xl">
      Honest, Reliable<br />Auto Repair
    </h1>
    <p class="mt-5 max-w-xl text-base text-slate-300 md:text-lg">
      Quality work at fair prices. First come, first served — call for current wait times and quick estimates.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-red-700"
        href={`tel:${settings.phoneHref}`}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        Call Now — {settings.phoneDisplay}
      </a>
      <a
        class="inline-flex items-center gap-2 rounded-xl border border-slate-600 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-slate-800"
        href={settings.googleMapsUrl}
        target="_blank"
        rel="noreferrer"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        Get Directions
      </a>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="mt-6 overflow-hidden rounded-2xl border bg-white shadow-sm">
    <div class="grid grid-cols-2 divide-x divide-y md:grid-cols-4 md:divide-y-0">
      {[
        { label: "Quality Guaranteed", sub: "Work done right the first time" },
        { label: "Fair Pricing", sub: "Honest estimates, no surprises" },
        { label: "Fast Turnaround", sub: "Efficient service you can count on" },
        { label: "Free Estimates", sub: "Call for a quick quote" },
      ].map(({ label, sub }) => (
        <div class="flex flex-col items-center justify-center gap-1 py-6 px-4 text-center">
          <div class="h-2 w-2 rounded-full bg-red-500"></div>
          <span class="mt-2 text-sm font-semibold text-slate-900">{label}</span>
          <span class="text-xs text-slate-500">{sub}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Quick Nav Cards -->
  <section class="section grid gap-5 sm:grid-cols-3">
    <a href="/services" class="group rounded-2xl border border-red-100 bg-red-50 p-6 transition-shadow hover:shadow-md">
      <div class="text-2xl">🔧</div>
      <h2 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">Services →</h2>
      <p class="mt-1 text-sm text-slate-600">Oil changes, brakes, diagnostics & more.</p>
    </a>
    <a href="/pricing" class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition-shadow hover:shadow-md">
      <div class="text-2xl">💰</div>
      <h2 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-slate-700 transition-colors">Pricing →</h2>
      <p class="mt-1 text-sm text-slate-600">Transparent estimates before we start work.</p>
    </a>
    <a href="/contact" class="group rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md">
      <div class="text-2xl">📍</div>
      <h2 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-slate-700 transition-colors">Contact →</h2>
      <p class="mt-1 text-sm text-slate-600">Located at {settings.addressLine1}, Newport News.</p>
    </a>
  </section>

</BaseLayout>
